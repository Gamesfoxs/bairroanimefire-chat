PORT=3010
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
NODE_ENV=production
CHAT_SSO_SECURE_COOKIES=1
CHAT_SSO_BASE_URL=https://bairroanimefire.com/auth/chat
CHAT_SSO_ISSUER=https://bairroanimefire.com/
CHAT_SSO_AUDIENCE=bairroanimefire-chat
CHAT_SSO_SECRET_FILE=/run/secrets/baf-chat-sso-secret
# Ou: CHAT_SSO_SECRET=hex_secreto_de_64+_chars
# Futuro: DATABASE_URL=mysql://user:pass@host:3306/bairroanimefire


# Arquivos do chat guardados no Object Storage S3 privado.
# Nunca publicar as credenciais em arquivos versionados ou no navegador.
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=sa-east-1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PREFIX=private/chat
